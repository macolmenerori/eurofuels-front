{
  "name": "eurofuels-front",
  "version": "1.0.0",
  "description": "A web application to show the current prices of fuels in the European Union.",
  "author": "macolmenerori",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0"
  },
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.cjs",
    "prettify": "prettier -w --log-level=silent src/",
    "lint": "eslint --fix ./src/",
    "test": "jest",
    "start": "webpack serve --port 3000",
    "types": "tsc --noEmit",
    "verify": "pnpm lint && pnpm prettify && pnpm types && pnpm test && pnpm audit --prod --prod && pnpm build",
    "gitleaks": "sh scripts/gitleaks.sh"
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.8",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.0",
    "swr": "^2.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@jest/types": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-testing-library": "^7.13.1",
    "html-webpack-plugin": "^5.6.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-fixed-jsdom": "^0.0.10",
    "mini-css-extract-plugin": "^2.9.4",
