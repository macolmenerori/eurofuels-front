{
  "name": "eurofuels-front",
  "version": "1.2.1",
  "description": "A web application to show the current prices of fuels in the European Union.",
  "author": "macolmenerori",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite-react-ssg dev",
    "build": "tsx scripts/generate-sitemap.ts && tsc -b && vite-react-ssg build",
    "preview": "vite-react-ssg preview",
    "prettify": "prettier -w --log-level=silent src/",
    "lint": "eslint --fix ./src/",
    "test": "jest",
    "types": "tsc --noEmit",
    "verify": "pnpm lint && pnpm prettify && pnpm types && pnpm test && pnpm audit --prod && pnpm build",
    "gitleaks": "sh scripts/gitleaks.sh",
    "release": "npx tsx scripts/release.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@macolmenerori/component-library": "^1.3.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "i18next": "^26.0.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.2",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@jest/types": "^30.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-fixed-jsdom": "^0.0.11",
    "msw": "^2.12.14",
    "postcss": "^8.5.8",
    "postcss-preset-env": "^11.2.0",
    "prettier": "^3.8.1",
    "react-helmet-async": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1",
    "vite-react-ssg": "^0.9.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "pnpm": {
    "overrides": {
      "yaml": "2.8.3"
    }
  }
}
