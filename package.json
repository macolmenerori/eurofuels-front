{
  "name": "eurofuels-front",
  "version": "2.1.0",
  "description": "A web application to show the current prices of fuels in the European Union.",
  "author": "macolmenerori",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "react-router dev",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "pnpm generate:sitemap && react-router build",
    "lint": "eslint --fix --no-error-on-unmatched-pattern ./app/",
    "prettify": "prettier -w --log-level=silent app/ || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm audit --prod && pnpm lint && pnpm prettify && pnpm test && pnpm build",
    "release": "npx tsx scripts/release.ts"
  },
  "dependencies": {
    "@datadog/browser-rum": "^7.6.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@macolmenerori/component-library": "^1.4.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5.2.1",
    "mapbox-gl": "^3.27.0",
    "react": "^19.2.7",
    "react-cookie-consent": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-router": "^8.3.0",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
